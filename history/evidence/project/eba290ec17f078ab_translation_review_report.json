      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 105,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-01990",
      "source_text": "Hartsock: Like we weren't afraid.",
      "ko": "하트삭: 마치 우리가 겁먹지 않았던 것처럼요.",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 61,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-01993",
      "source_text": "Hartsock: Oh you know, I talked his ear off.",
      "ko": "하트삭: 아시잖아요, 제가 귀가 아플 만큼 떠들어 댔죠.",
