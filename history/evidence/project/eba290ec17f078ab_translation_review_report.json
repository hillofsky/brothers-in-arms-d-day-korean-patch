      "pipe_count_ok": true,
      "ko_utf8_bytes": 16,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02311",
      "source_text": "Marshall: Sergeant Hartsock, you should get some rest.",
      "ko": "마셜: 하트삭 병장, 좀 쉬는 게 좋겠네.",
      "source_tokens": [],
