      "ko_utf8_bytes": 87,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02004",
      "source_text": "Hartsock: Sir.",
      "ko": "하트삭: 예.",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 15,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02005",
      "source_text": "Hartsock: Sir?",
      "ko": "하트삭: 예?",
      "source_tokens": [],
      "ko_tokens": [],
