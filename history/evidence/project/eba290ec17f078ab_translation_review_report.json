      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 27,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02010",
      "source_text": "Hartsock: Sort of, yes sir.",
      "ko": "하트삭: 뭐, 그런 셈입니다.",
