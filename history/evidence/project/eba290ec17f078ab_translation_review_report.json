      "resource_id": "BIA-02309",
      "source_text": "Marshall: Of course, Sergeant.",
      "ko": "마셜: 물론이지, 병장.",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 29,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02310",
      "source_text": "Marshall: Second?",
      "ko": "마셜: 2분대?",
      "source_tokens": [],
      "ko_tokens": [],
