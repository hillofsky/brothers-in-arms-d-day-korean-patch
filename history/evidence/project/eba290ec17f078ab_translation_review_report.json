      "pipe_count_ok": true,
      "ko_utf8_bytes": 15,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02006",
      "source_text": "Hartsock: Smells great.  Thank you, sir.",
      "ko": "하트삭: 냄새 좋네요. 감사합니다.",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 45,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02007",
      "source_text": "Hartsock: So how long is this gonna take?",
      "ko": "하트삭: 그래서 얼마나 걸립니까?",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 44,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-02009",
      "source_text": "Hartsock: Sorry, sir.",
      "ko": "하트삭: 죄송합니다.",
      "source_tokens": [],
