      "token_ok": true,
      "pipe_count_ok": true,
      "ko_utf8_bytes": 114,
      "max_bytes": ""
    },
    {
      "resource_id": "BIA-01996",
      "source_text": "Hartsock: Or anyone else.",
      "ko": "하트삭: 다른 누구도 아니었습니다.",
      "source_tokens": [],
      "ko_tokens": [],
      "token_ok": true,
