  "fields_detail": [
    {
      "field_index": 1,
      "offset_hex": "0x0",
      "field_bytes": 56,
      "time_start": "",
      "time_end": "",
      "english": "Bookends\\Near Cherbourg, France\\D+15 1230 June 21, 1944",
      "korean": "북엔드\\프랑스 셰르부르 근교\\D+15 12:30 1944.6.21",
      "encoded_content_bytes": 36
    },
    {
      "field_index": 2,
      "offset_hex": "0x57",
      "field_bytes": 132,
      "time_start": "00:01",
      "time_end": "00:10",
      "english": "Marshall: At ease, Sergeant.  Have a seat.\\  You... You want some coffee son?  It's fresh.\\  Well, as fresh as it gets around here.",
      "korean": "마셜: 편히 있게, 병장. 앉게.\\커피 한잔 하겠나? 갓 끓였네.\\뭐, 여기선 이게 최선이지.",
      "encoded_content_bytes": 52
    },
    {
      "field_index": 3,
      "offset_hex": "0xFC",
      "field_bytes": 83,
      "time_start": "00:11",
      "time_end": "00:16",
      "english": "Hartsock: Yes, sir.  Haven't had a good cup o' coffee in\\  three or four days now.",
      "korean": "하트삭: 네, 대령님. 제대로 된 커피는\\사흘이나 나흘 만입니다.",
      "encoded_content_bytes": 36
    },
    {
      "field_index": 4,
      "offset_hex": "0x170",
      "field_bytes": 41,
      "time_start": "00:17",
      "time_end": "00:19",
      "english": "Hartsock: Smells great.  Thank you, sir.",
      "korean": "하트삭: 향 좋군요. 감사합니다.",
      "encoded_content_bytes": 18
    },
    {
      "field_index": 5,
      "offset_hex": "0x1BA",
      "field_bytes": 25,
      "time_start": "00:20",
      "time_end": "00:21",
      "english": "Marshall: Name and rank?",
      "korean": "마셜: 이름과 계급은?",
      "encoded_content_bytes": 12
    },
    {
      "field_index": 6,
      "offset_hex": "0x1F4",
      "field_bytes": 69,
      "time_start": "00:22",
      "time_end": "00:27",
      "english": "Hartsock: Sgt. Joe Hartsock, sir.  Uh, well everyone\\  calls me Red.",
      "korean": "하트삭: 조 하트삭 병장입니다.\\다들 레드라고 부릅니다.",
      "encoded_content_bytes": 31
    },
    {
      "field_index": 7,
      "offset_hex": "0x25A",
      "field_bytes": 49,
      "time_start": "00:30",
      "time_end": "00:34",
      "english": "Hartsock: So how long is this gonna take?\\  Sir.",
      "korean": "하트삭: 이거 얼마나 걸립니까?\\대령님.",
      "encoded_content_bytes": 22
    },
    {
      "field_index": 8,
      "offset_hex": "0x2AC",
      "field_bytes": 47,
      "time_start": "00:34",
      "time_end": "00:36",
      "english": "Hartsock: I'd just like to get back to my men.",
      "korean": "하트삭: 부하들에게 돌아가고 싶습니다.",
      "encoded_content_bytes": 21
    },
    {
      "field_index": 9,
      "offset_hex": "0x2FC",
      "field_bytes": 35,
      "time_start": "00:37",
      "time_end": "00:38",
      "english": "Marshall: Second?\\  Hartsock: Sir?",
      "korean": "마셜: 2분대?\\하트삭: 네?",
      "encoded_content_bytes": 16
    },
    {
      "field_index": 10,
      "offset_hex": "0x340",
      "field_bytes": 54,
      "time_start": "00:40",
      "time_end": "00:43",
      "english": "Marshall: You and your men are in 2nd squad, correct?",
      "korean": "마셜: 자네와 부하들은 2분대가 맞지?",
      "encoded_content_bytes": 21
    },
    {
      "field_index": 11,
      "offset_hex": "0x397",
      "field_bytes": 91,
      "time_start": "00:44",
      "time_end": "00:49",
      "english": "Hartsock: Oh!  Yes, sir.  2nd took heavy losses in\\  Carentan. I was with 3rd at the time.",
      "korean": "하트삭: 네. 카랑탕에서 2분대 피해가 컸죠.\\전 그때 3분대였습니다.",
      "encoded_content_bytes": 39
    },
    {
      "field_index": 12,
      "offset_hex": "0x413",
      "field_bytes": 36,
      "time_start": "00:50",
      "time_end": "00:52",
      "english": "Marshall: Under Sgt. Matthew Baker?",
      "korean": "마셜: 매튜 베이커 병장 밑이었나?",
      "encoded_content_bytes": 19
    },
    {
      "field_index": 13,
      "offset_hex": "0x458",
      "field_bytes": 28,
      "time_start": "00:53",
      "time_end": "00:55",
      "english": "Hartsock: Sort of, yes sir.",
      "korean": "하트삭: 뭐, 그런 셈입니다.",
      "encoded_content_bytes": 16
    },
    {
      "field_index": 14,
      "offset_hex": "0x495",
      "field_bytes": 38,
      "time_start": "00:59",
      "time_end": "01:01",
      "english": "Marshall: Which brings us to Hill 30.",
      "korean": "마셜: 그래서 30고지 얘기로 넘어가지.",
      "encoded_content_bytes": 22
    },
    {
      "field_index": 15,
      "offset_hex": "0x4DC",
      "field_bytes": 50,
      "time_start": "01:02",
      "time_end": "01:04",
      "english": "Marshall: Sgt. Baker did a good job on that line.",
      "korean": "마셜: 베이커 병장은 그 전선에서 잘했어.",
      "encoded_content_bytes": 23
    },
    {
      "field_index": 16,
      "offset_hex": "0x52F",
      "field_bytes": 46,
      "time_start": "01:06",
      "time_end": "01:08",
      "english": "Marshall: Must have been one hell of a fight.",
      "korean": "마셜: 정말 지독한 싸움이었겠군.",
      "encoded_content_bytes": 18
    },
    {
      "field_index": 17,
      "offset_hex": "0x57E",
      "field_bytes": 32,
      "time_start": "01:11",
      "time_end": "01:13",
      "english": "Hartsock: Baker didn't save us.",
      "korean": "하트삭: 우릴 구한 건 베이커가 아닙니다.",
      "encoded_content_bytes": 23
    },
    {
      "field_index": 18,
      "offset_hex": "0x5BF",
      "field_bytes": 31,
      "time_start": "01:14",
      "time_end": "01:15",
      "english": "Marshall: Excuse me, Sergeant?",
      "korean": "마셜: 뭐라고 했나, 병장?",
      "encoded_content_bytes": 15
    },
    {
      "field_index": 19,
      "offset_hex": "0x5FF",
      "field_bytes": 22,
      "time_start": "01:17",
      "time_end": "01:18",
      "english": "Hartsock: Sorry, sir.",
      "korean": "하트삭: 죄송합니다.",
      "encoded_content_bytes": 11
    },
    {
      "field_index": 20,
      "offset_hex": "0x636",
      "field_bytes": 106,
      "time_start": "01:20",
      "time_end": "01:24",
      "english": "Hartsock: What I mean is... I've been hearing a lot of\\  talk around here that Baker saved us at Hill 30,",
      "korean": "하트삭: 제 말은... 30고지에서 베이커가\\우릴 구했다는 얘기를 많이 들었습니다.",
      "encoded_content_bytes": 46
    },
    {
      "field_index": 21,
      "offset_hex": "0x6C1",
      "field_bytes": 56,
      "time_start": "01:24",
      "time_end": "01:26",
      "english": "Hartsock: bringing in the 2nd Armored Division and all.",
      "korean": "하트삭: 2기갑사단까지 데려왔다고 말이죠.",
      "encoded_content_bytes": 23
    },
    {
      "field_index": 22,
      "offset_hex": "0x71A",
      "field_bytes": 36,
      "time_start": "01:27",
      "time_end": "01:29",
      "english": "Hartsock: That's not what happened.",
      "korean": "하트삭: 하지만 사실은 다릅니다.",
      "encoded_content_bytes": 18
    },
    {
      "field_index": 23,
      "offset_hex": "0x75F",
      "field_bytes": 36,
      "time_start": "01:31",
      "time_end": "01:33",
      "english": "Leggett: I need armor support now!!",
      "korean": "레게트: 당장 기갑 지원이 필요해!!",
      "encoded_content_bytes": 20
    },
    {
      "field_index": 24,
      "offset_hex": "0x7A4",
      "field_bytes": 29,
      "time_start": "01:33",
      "time_end": "01:34",
      "english": "Leggett: I mean right now!!!",
      "korean": "레게트: 지금 당장이라고!!!",
      "encoded_content_bytes": 16
    },
    {
      "field_index": 25,
      "offset_hex": "0x7E2",
      "field_bytes": 67,
      "time_start": "01:39",
      "time_end": "01:42",
      "english": "Hartsock: Leggett saved us.  Just no one wants to talk\\  about it.",
      "korean": "하트삭: 우릴 구한 건 레게트입니다.\\아무도 그 얘길 안 하려 하죠.",
      "encoded_content_bytes": 38
    },
    {
      "field_index": 26,
      "offset_hex": "0x846",
      "field_bytes": 33,
      "time_start": "01:43",
      "time_end": "01:45",
      "english": "Marshall: Why is that, Sergeant?",
      "korean": "마셜: 왜 그런가, 병장?",
      "encoded_content_bytes": 14
    },
    {
      "field_index": 27,
      "offset_hex": "0x888",
      "field_bytes": 20,
      "time_start": "01:46",
      "time_end": "01:49",
      "english": "Leggett: TAKE ME!!!",
      "korean": "레게트: 날 데려가!!!",
      "encoded_content_bytes": 13
    },
    {
      "field_index": 28,
      "offset_hex": "0x8BD",
      "field_bytes": 78,
      "time_start": "01:50",
      "time_end": "01:54",
      "english": "Hartsock: He somehow managed to reach HQ on the radio.\\  They sent the tanks.",
      "korean": "하트삭: 무전으로 어떻게든 본부에 닿았고,\\그들이 전차를 보냈습니다.",
      "encoded_content_bytes": 38
    },
    {
      "field_index": 29,
      "offset_hex": "0x92C",
      "field_bytes": 82,
      "time_start": "01:54",
      "time_end": "01:58",
      "english": "Marshall: I can't confirm that.  I thought Pvt.\\  Leggett's radio wasn't working.",
      "korean": "마셜: 확인이 안 되는군. 레게트 일병의\\무전기는 고장 난 줄 알았네.",
      "encoded_content_bytes": 39
    },
    {
      "field_index": 30,
      "offset_hex": "0x99F",
      "field_bytes": 58,
      "time_start": "01:58",
      "time_end": "02:02",
      "english": "Hartsock: Couldn't receive, sir, but he was transmitting.",
      "korean": "하트삭: 수신은 못 했지만 송신은 됐습니다.",
      "encoded_content_bytes": 24
    },
    {
      "field_index": 31,
      "offset_hex": "0x9FA",
      "field_bytes": 26,
      "time_start": "02:02",
      "time_end": "02:03",
      "english": "Marshall: And Sgt. Baker?",
      "korean": "마셜: 베이커 병장은?",
      "encoded_content_bytes": 12
    },
    {
      "field_index": 32,
      "offset_hex": "0xA35",
      "field_bytes": 156,
      "time_start": "02:08",
      "time_end": "02:15",
      "english": "Hartsock: He loved being in the thick of it.  Every time\\  I turned around in Normandy he'd been knocked out by\\  artillery or a mortar or some damn thing.",
      "korean": "하트삭: 그는 늘 한복판에 뛰어들었죠.\\노르망디에선 돌아볼 때마다 포탄이나\\박격포에 맞아 쓰러져 있었습니다.",
      "encoded_content_bytes": 60
    },
    {
      "field_index": 33,
      "offset_hex": "0xAF2",
      "field_bytes": 69,
      "time_start": "02:17",
      "time_end": "02:19",
      "english": "Hartsock: Yeah, he earned his stripes.  But so did the\\  rest of us.",
      "korean": "하트삭: 네, 계급장을 얻을 만했죠.\\하지만 우리 모두 그랬습니다.",
      "encoded_content_bytes": 37
    },
    {
      "field_index": 34,
      "offset_hex": "0xB58",
      "field_bytes": 32,
      "time_start": "02:22",
      "time_end": "02:23",
      "english": "Hartsock: And I do mean earned.",
      "korean": "하트삭: 정말 죽도록 얻은 겁니다.",
      "encoded_content_bytes": 19
    },
    {
      "field_index": 35,
      "offset_hex": "0xB99",
      "field_bytes": 67,
      "time_start": "02:30",
      "time_end": "02:34",
      "english": "Marshall: Baker got quite a scar.\\  Is yours from that battle too?",
      "korean": "마셜: 베이커에게 큰 흉터가 있더군.\\자네 것도 그 전투에서 생겼나?",
      "encoded_content_bytes": 38
    },
    {
      "field_index": 36,
      "offset_hex": "0xBFD",
      "field_bytes": 41,
      "time_start": "02:35",
      "time_end": "02:37",
      "english": "Drunken Man: How dare you touch my wife!",
      "korean": "취객: 감히 내 아내를 만져!",
      "encoded_content_bytes": 16
    },
    {
      "field_index": 37,
      "offset_hex": "0xC47",
      "field_bytes": 47,
      "time_start": "02:41",
      "time_end": "02:43",
      "english": "Hartsock: Can we just talk about Hill 30, sir?",
      "korean": "하트삭: 그냥 30고지 얘기나 하시죠.",
      "encoded_content_bytes": 21
    }
  ]
}
