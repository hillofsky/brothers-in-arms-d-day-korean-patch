    },
    {
      "resource_id": "BIA-02540",
      "classification": "DYNAMIC_INT_KEY_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 5,
      "section": "HINTS",
      "key": "Hint0",
      "original_raw_value": "Use the situational awareness view %icon_sa_view% to help track enemy movements.",
      "quote_style": "",
      "korean": "전술 상황 보기 %icon_sa_view%를 사용해 적의 움직임을 추적하라.",
      "target_raw_value": "전술 상황 보기 %icon_sa_view%를 사용해 적의 움직임을 추적하라.",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-02045",
      "classification": "DYNAMIC_INT_KEY_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 6,
      "section": "HINTS",
      "key": "Hint1",
      "original_raw_value": "If your teammate leaves the battle before it is over, you will receive his unused reinforcements.",
      "quote_style": "",
      "korean": "팀원이 전투가 끝나기 전에 이탈하면, 그가 쓰지 않은 증원 횟수를 받는다.",
      "target_raw_value": "팀원이 전투가 끝나기 전에 이탈하면, 그가 쓰지 않은 증원 횟수를 받는다.",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-02584",
      "classification": "DYNAMIC_INT_KEY_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 7,
      "section": "HINTS",
      "key": "Hint2",
      "original_raw_value": "Your teammate and his fire team are always visible to you! Use this to coordinate your attacks!",
      "quote_style": "",
      "korean": "팀원과 그의 사격조 위치는 항상 확인할 수 있다! 이를 활용해 공격을 연계하라!",
      "target_raw_value": "팀원과 그의 사격조 위치는 항상 확인할 수 있다! 이를 활용해 공격을 연계하라!",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-02044",
      "classification": "DYNAMIC_INT_KEY_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 8,
      "section": "HINTS",
      "key": "Hint3",
      "original_raw_value": "If your fireteam becomes suppressed, issue a fire command %icon_order% to rally them out of it!",
      "quote_style": "",
      "korean": "사격조가 제압당하면 %icon_order%로 사격 명령을 내려 제압 상태에서 벗어나게 하라!",
      "target_raw_value": "사격조가 제압당하면 %icon_order%로 사격 명령을 내려 제압 상태에서 벗어나게 하라!",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-02527",
      "classification": "INT_ONLY_OR_UNUSED_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 9,
      "section": "HINTS",
      "key": "Hint4",
      "original_raw_value": "Try to flank attacking enemies before they flank you!",
      "quote_style": "",
      "korean": "적에게 측면을 잡히기 전에 먼저 측면을 공격하라!",
      "target_raw_value": "적에게 측면을 잡히기 전에 먼저 측면을 공격하라!",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-01855",
      "classification": "INT_ONLY_OR_UNUSED_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 10,
      "section": "HINTS",
      "key": "Hint5",
      "original_raw_value": "Fire and movement is the key to success. Make sure the enemy is pinned down.",
      "quote_style": "",
      "korean": "사격과 기동이 승리의 열쇠다. 반드시 적을 제압하라.",
      "target_raw_value": "사격과 기동이 승리의 열쇠다. 반드시 적을 제압하라.",
      "source_sha1": "60f35bc8429fdc949eff59efd0e95978f959177d"
    },
    {
      "resource_id": "BIA-02369",
      "classification": "INT_ONLY_OR_UNUSED_CANDIDATE",
      "file": "S_SKR_HINTS.INT",
      "line": 11,
      "section": "HINTS",
      "key": "Hint6",
      "original_raw_value": "Not all encounters have flanks. Try to assault or use your grenades.",
