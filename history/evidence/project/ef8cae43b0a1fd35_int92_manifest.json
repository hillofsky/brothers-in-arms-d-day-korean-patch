    {
      "resource_id": "BIA-01642",
      "classification": "DYNAMIC_INT_KEY_CANDIDATE",
      "file": "D15_1230_BOOKENDS2.INT",
      "line": 7,
      "section": "LevelInfo0",
      "key": "TitleCaption",
      "original_raw_value": "Col. Marshall is surprised to hear that what Sgt. Hartsock tells him about Hill 30, is not exactly what some others had told him.",
      "quote_style": "",
      "korean": "마셜 대령은 하트삭 병장이 들려준 30고지의 이야기가 다른 이들에게 들은 내용과는 사뭇 달라 놀란다.",
      "target_raw_value": "마셜 대령은 하트삭 병장이 들려준 30고지의 이야기가 다른 이들에게 들은 내용과는 사뭇 달라 놀란다.",
      "source_sha1": "1cdc9ff700989ed5153aeb04bcf120e31d71316d"
    },
    {
      "resource_id": "BIA-01831",
      "classification": "INT_ONLY_OR_UNUSED_CANDIDATE",
      "file": "D15_1230_BOOKENDS2.INT",
      "line": 58,
      "section": "LocalizedStrings",
      "key": "DRUNKEN_MAN_A",
      "original_raw_value": "\"Drunken Man: She is my wife. How dare you touch my wife!\"",
      "quote_style": "\"",
      "korean": "취객: 내 아내야. 감히 내 아내한테 손을 대!",
